\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv}[2026/05/20 Yan Lin CV style]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[english]{babel}
\RequirePackage{microtype}
\emergencystretch=2em

\RequirePackage{sourcesanspro}
\renewcommand{\familydefault}{\sfdefault}

\RequirePackage[a4paper,
    top=1.8cm, bottom=2.0cm, left=2.0cm, right=2.0cm,
    headheight=14pt, footskip=1.0cm]{geometry}

\RequirePackage[dvipsnames]{xcolor}
\definecolor{accent}{HTML}{0D3363}
\definecolor{link}{HTML}{3568A8}
\definecolor{rule}{HTML}{B0B0B0}
\definecolor{muted}{HTML}{606060}

\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    urlcolor=link,
    linkcolor=link,
    citecolor=link,
    pdfauthor={Yan Lin}
}

\RequirePackage{titlesec}
\titleformat{\section}
    {\cvlarge\bfseries\color{accent}}{}{0pt}{}%
    [\vspace{2pt}{\color{rule}\titlerule[0.4pt]}]
\titlespacing*{\section}{0pt}{12pt}{6pt}
\titleformat{\subsection}
    {\cvmedium\bfseries\color{accent!85!black}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{8pt}{2pt}

\RequirePackage{enumitem}
\setlist{nosep, leftmargin=1.25em, labelsep=0.6em}
\setlist[itemize]{label=\textbullet}

\RequirePackage{array}
\RequirePackage{tabularx}

\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{needspace}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[L]{{\cvsmall\color{muted}Yan Lin / CV (updated \today)}}
\fancyfoot[R]{{\cvsmall\color{muted}\thepage\,/\,\NoHyper\pageref{LastPage}\endNoHyper}}

\newcommand{\cvhuge}{\fontsize{24pt}{28pt}\selectfont}
\newcommand{\cvlarge}{\fontsize{14pt}{17pt}\selectfont}
\newcommand{\cvmedium}{\fontsize{12pt}{14pt}\selectfont}
\newcommand{\cvnormal}{\fontsize{11pt}{13pt}\selectfont}
\newcommand{\cvsmall}{\fontsize{9pt}{11pt}\selectfont}
\let\normalsize\cvnormal

\newlength{\entryskip}
\setlength{\entryskip}{6pt}

\newcommand{\me}{\textbf{Yan Lin}}

\newcommand{\cvname}[1]{\noindent{\cvhuge\bfseries\color{accent}#1}\par\vspace{2pt}}
\newcommand{\cvtagline}[1]{\noindent{\cvmedium\color{muted}#1}\par\vspace{6pt}}

\newcommand{\tags}[1]{{\cvsmall #1}}

\newcommand{\pubentry}[4]{%
    \par\vspace{\entryskip}
    \needspace{4\baselineskip}%
    \noindent
    {\cvsmall\makebox[\linewidth][l]{\tags{#1}\hfill #2}\par\nobreak}%
    \noindent #3\par
    \ifx&#4&\else\nobreak\noindent{\cvsmall\color{muted}#4\par}\fi}

\newcommand{\roleentry}[4]{%
    \par
    \needspace{3\baselineskip}%
    \noindent
    \makebox[\linewidth][l]{\textbf{#1}\hfill{\cvsmall #3}}\par\nobreak
    \noindent #2\par\nobreak
    \ifx&#4&\else\noindent{\cvsmall\color{muted}#4}\par\fi
    \vspace{\entryskip}}

\newcommand{\descblock}[1]{%
    \par\noindent{\cvnormal #1}\par}

\newcommand{\award}[2]{\item \textbf{#1} \hfill {\color{muted}\cvsmall #2}}
